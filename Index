function getMonthData(monthName){
  const m = state.months[monthName];
  if(!m) return null;
  const entradas = (m.entradas||[]).reduce((s,r)=>s+(parseFloat(r.valor)||0),0);
  const catMap = {};
  [...(m.fixos||[]),...(m.gastos||[]),...(m.cartao||[])].forEach(r=>{
    const c=(r.categoria||'').trim(); if(!c) return;
    catMap[c]=(catMap[c]||0)+(parseFloat(r.valor)||0);
  });
  const totalSaidas = Object.values(catMap).reduce((s,v)=>s+v,0);
  const saldo = entradas - totalSaidas;
  return {entradas, catMap, totalSaidas, saldo};
}

function renderDFC(){
  const months = state.monthOrder;
  const showPct = document.getElementById('dfc-show-pct').checked;
  const allData = months.map(m=>({month:m, data:getMonthData(m)}));

  // gather all categories across all months
  const allCats = new Set();
  allData.forEach(({data})=>{ if(data) Object.keys(data.catMap).forEach(c=>allCats.add(c)); });
  const cats = [...allCats].sort();

  // header
  const head = document.getElementById('dfc-head');
  head.innerHTML = `<tr>
    <th>Item</th>
    ${months.map(m=>`<th class="${m===state.currentMonth?'dfc-month-cur':''}">${m}</th>`).join('')}
    ${showPct && months.length>=2 ? '<th style="color:#5B3C99;text-align:center;">Δ último mês</th>' : ''}
  </tr>`;

  function fmtCell(v){ return v===0 ? '<span style="color:#ccc">—</span>' : fmt(v); }
  function pctChip(prev, cur){
    if(!showPct || months.length<2 || prev===undefined) return '';
    if(prev===0 && cur===0) return '';
    if(prev===0) return `<span class="pct-chip up">novo</span>`;
    const pct = ((cur-prev)/Math.abs(prev))*100;
    const cls = pct>5?'up':pct<-5?'down':'neu';
    const sign = pct>0?'+':'';
    return `<span class="pct-chip ${cls}">${sign}${pct.toFixed(0)}%</span>`;
  }
  function lastTwoCols(rowVals){
    if(!showPct || months.length<2) return '';
    const last = rowVals[rowVals.length-1]??0;
    const prev = rowVals[rowVals.length-2]??0;
    if(prev===0&&last===0) return '<td style="text-align:center">—</td>';
    const pct = prev===0 ? null : ((last-prev)/Math.abs(prev))*100;
    const chip = pct===null ? `<span class="pct-chip up">novo</span>`
      : `<span class="pct-chip ${pct>5?'up':pct<-5?'down':'neu'}">${pct>0?'+':''}${pct.toFixed(0)}%</span>`;
    return `<td style="text-align:center">${chip}</td>`;
  }

  let rows = '';

  // ENTRADAS
  rows += `<tr class="row-section"><td colspan="${months.length + (showPct&&months.length>=2?2:1)}">Entradas</td></tr>`;
  const entVals = allData.map(({data})=>data?.entradas||0);
  rows += `<tr class="row-total-entrada">
    <td>💰 Total de entradas</td>
    ${entVals.map((v,i)=>`<td class="${months[i]===state.currentMonth?'dfc-month-cur':''}">${fmtCell(v)}</td>`).join('')}
    ${lastTwoCols(entVals)}
  </tr>`;

  // SAÍDAS por categoria
  rows += `<tr class="row-section"><td colspan="${months.length + (showPct&&months.length>=2?2:1)}">Saídas por categoria</td></tr>`;
  cats.forEach(cat=>{
    const vals = allData.map(({data})=>data?.catMap[cat]||0);
    if(vals.every(v=>v===0)) return;
    const hex = colorForCategory(cat);
    rows += `<tr>
      <td><span style="display:inline-block;width:8px;height:8px;border-radius:2px;background:${hex};margin-right:6px;vertical-align:middle;"></span>${cat}</td>
      ${vals.map((v,i)=>`<td class="${months[i]===state.currentMonth?'dfc-month-cur':''}">${fmtCell(v)}</td>`).join('')}
      ${lastTwoCols(vals)}
    </tr>`;
  });
  const totSaidaVals = allData.map(({data})=>data?.totalSaidas||0);
  rows += `<tr class="row-total-saida">
    <td>📤 Total de saídas</td>
    ${totSaidaVals.map((v,i)=>`<td class="${months[i]===state.currentMonth?'dfc-month-cur':''}">${fmtCell(v)}</td>`).join('')}
    ${lastTwoCols(totSaidaVals)}
  </tr>`;

  // SALDO
  const saldoVals = allData.map(({data})=>data?.saldo??0);
  rows += `<tr class="row-saldo">
    <td>💼 Saldo no caixa</td>
    ${saldoVals.map((v,i)=>`<td class="${months[i]===state.currentMonth?'dfc-month-cur':''}" style="color:${v>=0?'var(--good)':'var(--bad)'};">${fmtCell(v)}</td>`).join('')}
    ${lastTwoCols(saldoVals)}
  </tr>`;

  document.getElementById('dfc-body').innerHTML = rows;
}

