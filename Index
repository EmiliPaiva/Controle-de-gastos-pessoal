async function callClaude(messagesContent){
  const resp = await fetch('https://api.anthropic.com/v1/messages', {
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body: JSON.stringify({
      model:'claude-sonnet-4-6',
      max_tokens:1000,
      messages:[{role:'user', content: messagesContent}]
    })
  });
  if(!resp.ok) throw new Error('Falha na requisição ('+resp.status+')');
  const data = await resp.json();
  const textBlock = (data.content||[]).find(b=>b.type==='text');
  if(!textBlock) throw new Error('Resposta vazia da IA');
  let clean = textBlock.text.trim().replace(/^```json/,'').replace(/^```/,'').replace(/```$/,'').trim();
  return JSON.parse(clean);
}

function addPendingItems(items, destinoPadrao){
  items.forEach(it=>{
    const match = matchFornecedor(it.nome);
    if(match){
      match.usos = (match.usos||0) + 1;
      it.categoria = it.categoria || match.categoria;
      it.tipo = match.tipo || it.tipo;
      it.destino = match.destino || destinoPadrao;
    }
    pendingItems.push({
      nome: it.nome || 'Lançamento',
      tipo: (it.tipo==='Crédito') ? 'Crédito' : 'Débito',
      categoria: it.categoria || '',
      valor: Math.abs(parseFloat(it.valor)) || 0,
      destino: it.tipo==='Entrada' ? 'entradas' : (it.destino || destinoPadrao),
      selected: true
    });
  });
  saveState();
  renderReview();
}

