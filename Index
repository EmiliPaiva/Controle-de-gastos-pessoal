document.addEventListener('input', e=>{
  const t = e.target;
  if(t.dataset && t.dataset.p !== undefined){
    const i = +t.dataset.p, f = t.dataset.pf;
    let val = t.type==='checkbox' ? t.checked : (f==='valor' ? parseFloat(t.value)||0 : t.value);
    pendingItems[i][f] = val;
    if(f==='selected') renderReview();
  }
});

document.getElementById('btn-confirmar-import').addEventListener('click', ()=>{
  const selecionados = pendingItems.filter(p=>p.selected);
  const c = cm();
  selecionados.forEach(it=>{
    if(it.destino==='entradas'){
      c.entradas.push({nome:it.nome, valor:it.valor});
    } else if(it.destino==='fixos'){
      c.fixos.push({nome:it.nome, pago:false, tipo:it.tipo, categoria:it.categoria, valor:it.valor});
    } else if(it.destino==='cartao'){
      c.cartao.push({nome:it.nome, parcelas:'', pago:false, tipo:it.tipo, categoria:it.categoria, valor:it.valor});
    } else {
      c.gastos.push({nome:it.nome, tipo:it.tipo, categoria:it.categoria, valor:it.valor});
    }
  });
  pendingItems = pendingItems.filter(p=>!p.selected);
  saveState();
  renderAll();
  renderReview();
  document.getElementById('extrato-status').textContent = selecionados.length + ` lançamento(s) adicionados ao mês "${state.currentMonth}".`;
  document.getElementById('extrato-status').className = 'import-status';
});

/* --- Extrato --- */
document.getElementById('btn-analisar-extrato').addEventListener('click', async ()=>{
  const raw = document.getElementById('extrato-input').value.trim();
  const statusEl = document.getElementById('extrato-status');
  if(!raw){ statusEl.textContent='Cole o extrato antes de analisar.'; statusEl.className='import-status err'; return; }
  const btn = document.getElementById('btn-analisar-extrato');
  btn.disabled = true;
  statusEl.className='import-status';
  statusEl.innerHTML = '<span class="spinner" style="border-color:#2C4A7555;border-top-color:#2C4A75"></span> analisando extrato...';
  try{
    const cats = categoriasDisponiveis().join(', ');
    const prompt = `Você é um parser de extratos bancários brasileiros. Analise as linhas abaixo e retorne APENAS um array JSON (sem markdown, sem texto extra), no formato:
[{"nome":"nome do estabelecimento ou origem, curto","tipo":"Débito" ou "Crédito" ou "Entrada","categoria":"uma destas categorias: ${cats} (ou deixe vazio se não tiver certeza)","valor":123.45}]
Regras: valores negativos ou de saída são "Débito" ou "Crédito" (crédito se mencionar cartão de crédito, fatura ou parcelamento); valores positivos de recebimento (salário, pix recebido, depósito) são "Entrada". Ignore linhas de saldo. valor sempre positivo (número).

Extrato:
${raw}`;
    const items = await callClaude(prompt);
    if(!Array.isArray(items) || items.length===0){
      statusEl.textContent = 'Não consegui identificar lançamentos nesse texto.';
      statusEl.className='import-status err';
    } else {
      addPendingItems(items, 'gastos');
      statusEl.textContent = items.length + ' lançamento(s) encontrados — revise abaixo antes de adicionar.';
    }
  }catch(err){
    console.error(err);
    statusEl.textContent = 'Erro ao analisar o extrato. Tente novamente.';
    statusEl.className='import-status err';
  }finally{
    btn.disabled = false;
  }
});

/* --- Fotos de comprovantes --- */
document.getElementById('foto-input').addEventListener('change', e=>{
  fotoFiles = Array.from(e.target.files || []);
  const thumbRow = document.getElementById('thumb-row');
  thumbRow.innerHTML = '';
  fotoFiles.forEach(f=>{
    const url = URL.createObjectURL(f);
    const img = document.createElement('img');
    img.src = url;
    thumbRow.appendChild(img);
  });
  document.getElementById('btn-analisar-fotos').disabled = fotoFiles.length===0;
});

function fileToBase64(file){
  return new Promise((resolve, reject)=>{
    const r = new FileReader();
    r.onload = () => resolve(r.result.split(',')[1]);
    r.onerror = () => reject(new Error('Falha ao ler arquivo'));
    r.readAsDataURL(file);
  });
}

document.getElementById('btn-analisar-fotos').addEventListener('click', async ()=>{
  const statusEl = document.getElementById('foto-status');
  const btn = document.getElementById('btn-analisar-fotos');
  if(fotoFiles.length===0) return;
  btn.disabled = true;
  const cats = categoriasDisponiveis().join(', ');
  let okCount = 0, failCount = 0;
  for(let idx=0; idx<fotoFiles.length; idx++){
    statusEl.className='import-status';
    statusEl.innerHTML = `<span class="spinner" style="border-color:#2C4A7555;border-top-color:#2C4A75"></span> lendo comprovante ${idx+1} de ${fotoFiles.length}...`;
    try{
      const file = fotoFiles[idx];
      const base64 = await fileToBase64(file);
      const mediaType = file.type || 'image/jpeg';
      const prompt = `Esta imagem é um comprovante, recibo ou nota fiscal. Extraia os dados e retorne APENAS um array JSON (sem markdown, sem texto extra) com um único item, no formato:
[{"nome":"nome do estabelecimento","tipo":"Débito" ou "Crédito","categoria":"uma destas categorias: ${cats} (ou vazio se não tiver certeza)","valor":123.45}]
Use o valor TOTAL pago no comprovante. Se não identificar tipo de pagamento, use "Débito".`;
      const content = [
        {type:'image', source:{type:'base64', media_type: mediaType, data: base64}},
        {type:'text', text: prompt}
      ];
      const items = await callClaude(content);
      if(Array.isArray(items) && items.length>0){
        addPendingItems(items, 'gastos');
        okCount++;
      } else {
        failCount++;
      }
    }catch(err){
      console.error(err);
      failCount++;
    }
  }
  statusEl.textContent = `${okCount} comprovante(s) lido(s)` + (failCount ? `, ${failCount} com falha.` : '.') + ' Revise abaixo antes de adicionar.';
  statusEl.className = failCount && !okCount ? 'import-status err' : 'import-status';
  btn.disabled = false;
  fotoFiles = [];
  document.getElementById('thumb-row').innerHTML = '';
  document.getElementById('foto-input').value = '';
  document.getElementById('btn-analisar-fotos').disabled = true;
});

/* =================== BASE DE DADOS DE FORNECEDORES =================== */

const EXEMPLOS_FORN = [
  {nome:'Uber', apelido:'UBER*', categoria:'Uber', tipo:'Crédito', destino:'gastos', obs:'', usos:0},
  {nome:'iFood', apelido:'IFOOD*', categoria:'Comida', tipo:'Crédito', destino:'gastos', obs:'delivery', usos:0},
  {nome:'Streaming (Netflix/Spotify)', apelido:'NETFLIX, SPOTIFY', categoria:'Contas', tipo:'Crédito', destino:'fixos', obs:'assinaturas', usos:0},
  {nome:'Apple', apelido:'APPLE.COM/BILL', categoria:'Contas', tipo:'Crédito', destino:'fixos', obs:'', usos:0},
  {nome:'Farmácia', apelido:'DROGASIL, DROGARIA', categoria:'Variáveis', tipo:'Débito', destino:'gastos', obs:'', usos:0},
  {nome:'Supermercado', apelido:'CARREFOUR, EXTRA, PÃO DE AÇÚCAR', categoria:'Comida', tipo:'Débito', destino:'gastos', obs:'', usos:0},
  {nome:'Posto de combustível', apelido:'SHELL, IPIRANGA, BR', categoria:'Transporte facul/trab', tipo:'Débito', destino:'gastos', obs:'', usos:0},
  {nome:'Salário', apelido:'FOLHA, SALARIO, PGTO SALARIO', categoria:'', tipo:'Débito', destino:'entradas', obs:'receita', usos:0},
];

let fornSort = {col:'nome', dir:1};
let fornFiltro = {texto:'', categoria:'', tipo:''};

function matchFornecedor(nomeExtrato){
  const nome = (nomeExtrato||'').toLowerCase();
  for(const f of state.fornecedores){
    const palavras = (f.apelido||f.nome||'').toLowerCase().split(/[,;]+/).map(s=>s.trim()).filter(Boolean);
    for(const p of palavras){
      if(p && nome.includes(p)) return f;
    }
    if(nome.includes((f.nome||'').toLowerCase())) return f;
  }
  return null;
}

function renderFornecedores(){
  const cats = state.budgets.map(b=>b.categoria);

  // populate filter category
  const catSel = document.getElementById('forn-filtro-cat');
  const prevCat = catSel.value;
  catSel.innerHTML = '<option value="">Todas categorias</option>' + cats.map(c=>`<option value="${c}">${c}</option>`).join('');
  catSel.value = prevCat;

  let rows = state.fornecedores.filter(f=>{
    if(fornFiltro.categoria && f.categoria!==fornFiltro.categoria) return false;
    if(fornFiltro.tipo && f.tipo!==fornFiltro.tipo) return false;
    if(fornFiltro.texto && !(f.nome+f.apelido+f.obs||'').toLowerCase().includes(fornFiltro.texto.toLowerCase())) return false;
    return true;
  });

  rows = [...rows].sort((a,b)=>{
    const av = (a[fornSort.col]||''), bv = (b[fornSort.col]||'');
    if(typeof av==='number') return (av-bv)*fornSort.dir;
    return av.toString().localeCompare(bv.toString())*fornSort.dir;
  });

  document.getElementById('forn-count').textContent = rows.length + ' de ' + state.fornecedores.length + ' fornecedores';
  document.getElementById('forn-empty').style.display = state.fornecedores.length===0 ? 'block' : 'none';

  const destinos = ['gastos','fixos','cartao','entradas'];
  const destLabels = {'gastos':'Gastos do mês','fixos':'Fixos','cartao':'Cartão','entradas':'Entradas'};

  document.getElementById('forn-body').innerHTML = rows.map(r=>{
    const i = state.fornecedores.indexOf(r);
    return `<tr>
      <td><input type="text" value="${r.nome||''}" data-fi="${i}" data-ff="nome" placeholder="nome do fornecedor"></td>
      <td><input type="text" value="${r.apelido||''}" data-fi="${i}" data-ff="apelido" placeholder="ex: UBER*, IFOOD*"></td>
      <td>
        <select data-fi="${i}" data-ff="categoria">
          <option value="">—</option>
          ${cats.map(c=>`<option value="${c}" ${c===r.categoria?'selected':''}>${c}</option>`).join('')}
        </select>
      </td>
      <td>
        <select class="tipo-${r.tipo}" data-fi="${i}" data-ff="tipo">
          <option value="Débito" ${r.tipo==='Débito'?'selected':''}>Débito</option>
          <option value="Crédito" ${r.tipo==='Crédito'?'selected':''}>Crédito</option>
        </select>
      </td>
      <td>
        <select data-fi="${i}" data-ff="destino">
          ${destinos.map(d=>`<option value="${d}" ${d===r.destino?'selected':''}>${destLabels[d]}</option>`).join('')}
        </select>
      </td>
      <td><input type="text" value="${r.obs||''}" data-fi="${i}" data-ff="obs" placeholder="observação..."></td>
      <td class="num-uso">${r.usos||0}</td>
      <td><button class="del-btn" data-delforn="${i}">✕</button></td>
    </tr>`;
  }).join('');

  // update sort icons
  ['nome','categoria','tipo','usos'].forEach(col=>{
    const el = document.getElementById('sort-'+col);
    if(el) el.textContent = fornSort.col===col ? (fornSort.dir===1?'▲':'▼') : '⇅';
  });
}

document.addEventListener('input', e=>{
  const t = e.target;
  if(t.dataset && t.dataset.fi !== undefined){
    const i = +t.dataset.fi, f = t.dataset.ff;
    if(state.fornecedores[i]) state.fornecedores[i][f] = t.value;
    saveState();
    if(f==='tipo') t.className = 'tipo-'+t.value;
  }
});
document.addEventListener('change', e=>{
  const t = e.target;
  if(t.dataset && t.dataset.fi !== undefined){
    const i = +t.dataset.fi, f = t.dataset.ff;
    if(state.fornecedores[i]) state.fornecedores[i][f] = t.value;
    saveState();
    if(f==='tipo') t.className = 'tipo-'+t.value;
  }
});
document.addEventListener('click', e=>{
  const delForn = e.target.closest('[data-delforn]');
  if(delForn){
    state.fornecedores.splice(+delForn.dataset.delforn, 1);
    saveState(); renderFornecedores(); return;
  }
});
document.getElementById('forn-add-btn').addEventListener('click', ()=>{
  state.fornecedores.unshift({nome:'', apelido:'', categoria:'', tipo:'Débito', destino:'gastos', obs:'', usos:0});
  saveState(); renderFornecedores();
});
document.getElementById('forn-busca').addEventListener('input', e=>{ fornFiltro.texto=e.target.value; renderFornecedores(); document.getElementById('forn-busca').focus(); });
document.getElementById('forn-filtro-cat').addEventListener('change', e=>{ fornFiltro.categoria=e.target.value; renderFornecedores(); });
document.getElementById('forn-filtro-tipo').addEventListener('change', e=>{ fornFiltro.tipo=e.target.value; renderFornecedores(); });
document.getElementById('forn-limpar').addEventListener('click', ()=>{ fornFiltro={texto:'',categoria:'',tipo:''}; document.getElementById('forn-busca').value=''; document.querySelectorAll('#forn-filtro-cat, #forn-filtro-tipo').forEach(s=>s.value=''); renderFornecedores(); });

document.querySelectorAll('.forn-table th.sortable').forEach(th=>{
  th.addEventListener('click', ()=>{
    const col = th.dataset.col;
    if(fornSort.col===col) fornSort.dir *= -1;
    else { fornSort.col=col; fornSort.dir=1; }
    renderFornecedores();
  });
});

document.getElementById('forn-popular').addEventListener('click', ()=>{
  if(!confirm('Adicionar exemplos de fornecedores comuns à base? Não substitui os existentes.')) return;
  EXEMPLOS_FORN.forEach(ex=>{
    if(!state.fornecedores.find(f=>f.nome===ex.nome)){
      state.fornecedores.push({...ex});
    }
  });
  saveState(); renderFornecedores();
});

document.getElementById('forn-exportar').addEventListener('click', ()=>{
  const rows = [['Nome','Apelido','Categoria','Tipo','Destino','Obs','Usos']];
  state.fornecedores.forEach(f=>rows.push([f.nome,f.apelido,f.categoria,f.tipo,f.destino,f.obs,f.usos||0]));
  const csv = rows.map(r=>r.map(c=>'"'+String(c).replace(/"/g,'""')+'"').join(',')).join('\n');
  const a = document.createElement('a');
  a.href = 'data:text/csv;charset=utf-8,' + encodeURIComponent(csv);
  a.download = 'fornecedores.csv';
  a.click();
});

loadState();
