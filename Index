<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Setembro · Contabilidade Pessoal</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#F4F5F7; --card:#FFFFFF; --border:#E1E4EA; --text:#2B2E33; --muted:#7C818C;
  --tipo-debito-bg:#E4DAF6; --tipo-debito-text:#6E3FC2;
  --tipo-credito-bg:#8E5FDE; --tipo-credito-text:#FFFFFF;
  --good:#3E9B5C; --warn:#E08A2E; --bad:#C0273D;
}
*{box-sizing:border-box;}
body{margin:0; background:var(--bg); font-family:'Montserrat', sans-serif; color:var(--text); padding:0 24px 50px; font-size:12.5px;}

/* TABS */
.tabbar{display:flex; gap:2px; padding:18px 0 0; margin-bottom:14px;}
.tabbtn{font-weight:700; font-size:13px; padding:10px 20px; background:#E7E9ED; color:#6B7078; border:none; border-radius:6px 6px 0 0; cursor:pointer;}
.tabbtn.active{background:var(--card); color:var(--text);}
.tabpage{display:none;}
.tabpage.active{display:block;}

/* TAB1 base */
.title-row{display:grid; grid-template-columns:1fr 1fr 1fr; align-items:flex-start; margin-bottom:12px;}
.gasto-box{background:var(--card); border:1px solid var(--border); border-radius:5px; padding:8px 16px; display:inline-flex; align-items:center; gap:8px;}
.gasto-box .label{font-size:11px; font-weight:600; color:var(--muted);}
.gasto-box input{font-size:16px; font-weight:700; border:none; background:transparent; width:90px; color:var(--text); font-family:inherit;}
h1{text-align:center; font-size:38px; font-weight:800; margin:0; letter-spacing:-0.01em;}

.grid4{display:grid; grid-template-columns:1.1fr 0.85fr 1.3fr; gap:12px; align-items:start;}
@media (max-width:1150px){ .grid4{grid-template-columns:1fr 1fr;} }
@media (max-width:640px){ .grid4{grid-template-columns:1fr;} }
.grid3{display:grid; grid-template-columns:1.15fr 0.95fr 0.75fr; gap:12px; align-items:start; margin-top:12px;}
@media (max-width:1150px){ .grid3{grid-template-columns:1fr 1fr;} }
@media (max-width:640px){ .grid3{grid-template-columns:1fr;} }
.col{display:flex; flex-direction:column; gap:10px;}

.banner{border-radius:4px; padding:8px 14px; display:flex; justify-content:space-between; align-items:center; font-weight:700; font-size:12.5px;}
.banner.blue{background:#DCEBF9; color:#1B5E8C;}
.banner.yellow{background:#FBF0CE; color:#8A6D1A;}
.banner.pink{background:#F5E1EE; color:#7A3C6E;}

.card{background:var(--card); border:1px solid var(--border); border-radius:5px; overflow:hidden;}
.card .head{background:#EAF0FB; color:#2C4A75; font-weight:700; font-size:12px; text-align:center; padding:6px;}
.card .head.pink{background:#F5E7F3; color:#7A3C6E;}
.card .head.green{background:#E4F2E6; color:#2C6B3F;}
.card .head.red{background:#C0273D; color:#fff;}

table{width:100%; border-collapse:collapse; font-size:11.5px;}
thead th{text-align:left; font-size:10px; font-weight:600; color:var(--muted); text-transform:uppercase; padding:5px 6px; border-bottom:1px solid var(--border); background:#FAFAFB;}
tbody td{padding:3px 6px; border-bottom:1px solid var(--border); vertical-align:middle;}
tbody tr:last-child td{border-bottom:none;}
.num{text-align:right;}

input[type=text], input[type=number], select{
  width:100%; border:none; background:transparent; font-family:inherit; font-size:11.5px; color:var(--text); padding:3px 2px; border-radius:3px;
}
input[type=text]:focus, input[type=number]:focus, select:focus{outline:none; background:#F0F2F6;}
input[type=number]{text-align:right; font-weight:600;}
input[type=checkbox]{width:13px;height:13px;accent-color:var(--good);cursor:pointer;}
select{cursor:pointer; font-weight:700; padding:2px 4px;}
select.tipo-Débito{background:var(--tipo-debito-bg); color:var(--tipo-debito-text);}
select.tipo-Crédito{background:var(--tipo-credito-bg); color:var(--tipo-credito-text);}
input.cat-input{font-weight:700; border-radius:4px; padding:2px 6px;}

.del-btn{background:none; border:none; cursor:pointer; color:var(--bad); font-size:13px; opacity:0.5; padding:0 3px;}
.del-btn:hover{opacity:1;}
.add-btn{
  display:block; width:100%; text-align:center; font-size:10.5px; font-weight:700; color:var(--muted);
  background:#FAFAFB; border:none; border-top:1px dashed var(--border); padding:7px; cursor:pointer;
}
.add-btn:hover{color:var(--text); background:#F0F2F6;}

.total-line{display:flex; justify-content:space-between; align-items:center; padding:6px 8px; font-weight:700; font-size:11.5px; border-top:1px solid var(--border);}
.saldo-strip{display:flex; gap:8px; align-items:center; font-weight:700; font-size:12px; padding:2px 4px 8px;}
.saldo-strip .a{color:#2B2E33;} .saldo-strip .b{color:#3E9B5C;} .saldo-strip .c{color:#C0273D;}

.budget-table thead th{background:#C0273D; color:#fff; font-size:10px; text-transform:none; font-weight:700;}
.budget-table input[type=number]{font-weight:600;}

.pie-wrap{display:flex; align-items:center; gap:14px; padding:12px;}
.pie{width:150px; height:150px; border-radius:50%; flex-shrink:0;}
.legend{font-size:10.5px; display:flex; flex-direction:column; gap:4px;}
.legend .item{display:flex; align-items:center; gap:6px;}
.legend .dot{width:9px; height:9px; border-radius:50%; flex-shrink:0;}
.legend .pct{color:var(--muted); margin-left:auto; padding-left:8px;}
.footnote{text-align:center; color:#9CA0AA; font-size:10.5px; margin-top:22px;}

/* month selector */
.month-bar{display:flex; align-items:center; justify-content:center; gap:10px; margin-bottom:4px;}
.month-bar select{
  border:1px solid var(--border); border-radius:5px; padding:6px 10px; font-family:inherit; font-weight:700;
  font-size:12px; background:var(--card); color:var(--text); cursor:pointer;
}
.month-bar button{
  border:1px solid var(--border); border-radius:5px; padding:6px 10px; font-family:inherit; font-weight:700;
  font-size:12px; background:var(--card); color:var(--muted); cursor:pointer;
}
.month-bar button:hover{color:var(--text); background:#F0F2F6;}
.month-bar .del-month{color:var(--bad); border-color:#F0C7CC;}

/* filter bar */
.filter-bar{
  display:flex; flex-wrap:wrap; gap:10px; align-items:center; background:var(--card); border:1px solid var(--border);
  border-radius:6px; padding:10px 14px; margin-bottom:14px;
}
.filter-bar .flabel{font-size:10.5px; font-weight:700; color:var(--muted); text-transform:uppercase;}
.filter-bar input[type=text], .filter-bar select{
  border:1px solid var(--border); border-radius:5px; padding:5px 8px; font-family:inherit; font-size:11.5px; background:#FAFAFB; color:var(--text); width:auto;
}
.filter-bar input[type=text]{min-width:160px;}
.filter-bar .clear-filters{
  background:none; border:none; color:var(--bad); font-size:11px; font-weight:700; cursor:pointer; padding:4px 6px;
}
.filter-note{font-size:10px; color:var(--muted); font-style:italic; text-align:center; padding:4px 0;}

/* TAB2 */
.dash-head{margin-bottom:16px;}
.dash-head h2{font-size:24px; font-weight:800; margin:0 0 2px;}
.dash-head p{margin:0; color:var(--muted); font-size:12px;}
.kpi-row{display:grid; grid-template-columns:repeat(6,1fr); gap:12px; margin-bottom:16px;}
@media (max-width:1200px){ .kpi-row{grid-template-columns:repeat(3,1fr);} }
@media (max-width:700px){ .kpi-row{grid-template-columns:1fr 1fr;} }
.kpi{background:var(--card); border:1px solid var(--border); border-radius:6px; padding:14px 16px;}
.kpi .label{font-size:10.5px; font-weight:600; color:var(--muted); text-transform:uppercase; margin-bottom:6px;}
.kpi .value{font-size:22px; font-weight:800;}
.kpi .sub{font-size:10.5px; margin-top:4px; font-weight:600;}
.kpi .sub.good{color:var(--good);} .kpi .sub.warn{color:var(--warn);} .kpi .sub.bad{color:var(--bad);}
.dash-grid{display:grid; grid-template-columns:1.2fr 1fr 0.85fr; gap:14px;}
@media (max-width:1100px){ .dash-grid{grid-template-columns:1fr 1fr;} }
@media (max-width:700px){ .dash-grid{grid-template-columns:1fr;} }
.panel{background:var(--card); border:1px solid var(--border); border-radius:6px; padding:16px 18px; margin-bottom:14px;}
.panel h3{font-size:13.5px; font-weight:700; margin:0 0 3px;}
.panel .desc{font-size:10.5px; color:var(--muted); margin:0 0 14px;}
.bar-row{display:grid; grid-template-columns:150px 1fr 90px 70px; align-items:center; gap:10px; padding:7px 0; border-bottom:1px solid var(--border); font-size:11.5px;}
.bar-row:last-child{border-bottom:none;}
.bar-row .cat{font-weight:600; display:flex; align-items:center; gap:6px;}
.bar-row .cat .sw{width:8px; height:8px; border-radius:2px; flex-shrink:0;}
.bar-track2{height:10px; background:#EEF0F3; border-radius:5px; overflow:hidden;}
.bar-fill2{height:100%; border-radius:5px;}
.bar-row .val{text-align:right; font-weight:700;}
.bar-row .pct{text-align:right; color:var(--muted); font-size:10.5px;}
.reduc-row{display:grid; grid-template-columns:150px 1fr 60px; align-items:center; gap:10px; padding:8px 0; border-bottom:1px solid var(--border); font-size:11.5px;}
.reduc-row:last-child{border-bottom:none;}
.reduc-track{height:8px; background:#EEF0F3; border-radius:5px; overflow:hidden;}
.reduc-fill{height:100%; border-radius:5px; background:linear-gradient(90deg,#3E9B5C,#E08A2E,#C0273D);}
.reduc-idx{text-align:right; font-weight:800;}
.reduc-idx.good{color:var(--good);} .reduc-idx.warn{color:var(--warn);} .reduc-idx.bad{color:var(--bad);}
.alert{display:flex; gap:10px; padding:11px 12px; border-radius:6px; margin-bottom:8px; align-items:flex-start;}
.alert:last-child{margin-bottom:0;}
.alert .icon{font-size:15px; line-height:1; margin-top:1px;}
.alert .body b{display:block; font-size:12px; margin-bottom:2px;}
.alert .body span{font-size:10.5px; color:var(--muted);}
.alert.bad{background:#FCE9EB;} .alert.bad .icon{color:var(--bad);} .alert.bad b{color:#8E1526;}
.alert.warn{background:#FDF3E1;} .alert.warn .icon{color:var(--warn);} .alert.warn b{color:#8A5A16;}
.alert.good{background:#E5F5E9;} .alert.good .icon{color:var(--good);} .alert.good b{color:#1F5C33;}
.split-bar{display:flex; height:22px; border-radius:5px; overflow:hidden; margin-top:6px;}
.split-bar span{height:100%;}
.split-legend{display:flex; justify-content:space-between; font-size:10.5px; color:var(--muted); margin-top:6px;}

/* TAB4 - base de dados */
.forn-toolbar{
  display:flex; gap:10px; align-items:center; flex-wrap:wrap;
  background:var(--card); border:1px solid var(--border); border-radius:6px;
  padding:10px 14px; margin-bottom:14px;
}
.forn-toolbar input[type=text]{
  border:1px solid var(--border); border-radius:5px; padding:5px 10px;
  font-family:inherit; font-size:11.5px; background:#FAFAFB; color:var(--text);
  min-width:200px; width:auto;
}
.forn-toolbar select{
  border:1px solid var(--border); border-radius:5px; padding:5px 8px;
  font-family:inherit; font-size:11.5px; background:#FAFAFB; color:var(--text); width:auto;
}
.forn-count{font-size:11px; color:var(--muted); margin-left:auto;}
.forn-table{width:100%; border-collapse:collapse; font-size:12px;}
.forn-table thead th{
  text-align:left; font-size:10px; font-weight:700; color:var(--muted); text-transform:uppercase;
  padding:8px 10px; border-bottom:2px solid var(--border); background:#FAFAFB; position:sticky; top:0;
}
.forn-table thead th.sortable{cursor:pointer; user-select:none;}
.forn-table thead th.sortable:hover{color:var(--text);}
.forn-table thead th .sort-icon{font-size:9px; margin-left:3px; opacity:0.5;}
.forn-table thead th.active-sort .sort-icon{opacity:1; color:#2C4A75;}
.forn-table tbody td{padding:6px 10px; border-bottom:1px solid var(--border); vertical-align:middle;}
.forn-table tbody tr:hover{background:#FAFBFC;}
.forn-table tbody tr:last-child td{border-bottom:none;}
.forn-table input[type=text], .forn-table select{
  width:100%; border:1px solid transparent; background:transparent; font-family:inherit;
  font-size:12px; color:var(--text); padding:3px 4px; border-radius:3px;
}
.forn-table input[type=text]:focus, .forn-table select:focus{
  outline:none; border-color:var(--border); background:#F0F2F6;
}
.forn-table .num-uso{text-align:center; font-weight:700; color:var(--muted); font-size:11px;}
.forn-table .match-tag{
  display:inline-block; font-size:9.5px; font-weight:700; padding:1px 6px;
  border-radius:3px; background:#EEF0F3; color:#5C6070;
}
.forn-empty{text-align:center; padding:40px; color:var(--muted); font-size:12px;}
.forn-actions-row{display:flex; justify-content:space-between; align-items:center; margin-top:12px; flex-wrap:wrap; gap:10px;}
.btn-secondary{
  background:#F0F2F6; color:var(--text); border:1px solid var(--border); border-radius:6px;
  padding:7px 14px; font-weight:700; font-size:12px; cursor:pointer; font-family:inherit;
}
.btn-secondary:hover{background:#E7E9ED;}
.auto-badge{
  display:inline-flex; align-items:center; gap:4px;
  background:#E5F5E9; color:#1F5C33; font-size:10px; font-weight:700;
  padding:2px 7px; border-radius:20px; border:1px solid #B8E0C3; margin-left:6px;
}

/* DFC comparativo */
.dfc-panel{}
.dfc-table{width:100%; border-collapse:collapse; font-size:11.5px; min-width:600px;}
.dfc-table thead th{
  text-align:right; font-size:10px; font-weight:700; color:var(--muted);
  text-transform:uppercase; padding:7px 10px; border-bottom:2px solid var(--border);
  background:#FAFAFB; white-space:nowrap;
}
.dfc-table thead th:first-child{text-align:left; min-width:160px; position:sticky; left:0; background:#FAFAFB; z-index:1;}
.dfc-table tbody td{
  padding:6px 10px; border-bottom:1px solid var(--border);
  text-align:right; white-space:nowrap; font-variant-numeric:tabular-nums;
}
.dfc-table tbody td:first-child{
  text-align:left; font-weight:600; position:sticky; left:0; background:#fff; z-index:1;
}
.dfc-table tbody tr:hover td{background:#F9FAFB;}
.dfc-table tbody tr:hover td:first-child{background:#F9FAFB;}
.dfc-table .row-section td{
  background:#F4F5F7; font-weight:800; font-size:10px; text-transform:uppercase;
  letter-spacing:0.06em; color:var(--muted); padding:8px 10px 4px; border-bottom:none;
}
.dfc-table .row-total-entrada td{
  background:#E9F6EE; font-weight:700; border-top:1px solid #B8E0C3; border-bottom:2px solid #B8E0C3;
}
.dfc-table .row-total-saida td{
  background:#FBE9EC; font-weight:700; border-top:1px solid #F0B8C0; border-bottom:2px solid #F0B8C0;
}
.dfc-table .row-saldo td{
  background:#EAE0F6; font-weight:800; font-size:13px; border-top:2px solid #C5B0E0; border-bottom:none;
}
.dfc-table .row-saldo td:first-child{color:#5B3C99;}
.pct-chip{
  display:inline-block; font-size:9px; font-weight:700; padding:1px 5px;
  border-radius:3px; margin-left:5px; vertical-align:middle;
}
.pct-chip.up{background:#FCE9EB; color:#A62236;}
.pct-chip.down{background:#E5F5E9; color:#1F5C33;}
.pct-chip.neu{background:#EEF0F3; color:#5C6070;}
.dfc-month-cur{background:#EAF0FB !important; font-weight:700;}
.dfc-month-cur:first-child{background:#EAF0FB !important;}

/* TAB3 - importar */
.import-grid{display:grid; grid-template-columns:1fr 1fr; gap:14px;}
@media (max-width:900px){ .import-grid{grid-template-columns:1fr;} }
.import-panel textarea{
  width:100%; min-height:140px; border:1px solid var(--border); border-radius:6px; padding:10px;
  font-family:'Montserrat',sans-serif; font-size:12px; resize:vertical; color:var(--text);
}
.import-panel .drop{
  border:2px dashed var(--border); border-radius:8px; padding:22px; text-align:center; color:var(--muted);
  cursor:pointer; font-size:12px; margin-bottom:10px;
}
.import-panel .drop:hover{border-color:#B9BFCB; background:#FAFAFB;}
.import-panel .drop input{display:none;}
.thumb-row{display:flex; flex-wrap:wrap; gap:8px; margin-bottom:10px;}
.thumb-row img{width:56px; height:56px; object-fit:cover; border-radius:6px; border:1px solid var(--border);}
.btn-primary{
  background:#2C4A75; color:#fff; border:none; border-radius:6px; padding:9px 16px; font-weight:700;
  font-size:12px; cursor:pointer; font-family:inherit;
}
.btn-primary:hover{background:#1F3557;}
.btn-primary:disabled{background:#B9C0CC; cursor:not-allowed;}
.spinner{display:inline-block; width:12px; height:12px; border:2px solid #ffffff55; border-top-color:#fff; border-radius:50%; animation:spin .7s linear infinite; margin-right:6px; vertical-align:middle;}
@keyframes spin{to{transform:rotate(360deg);}}
.import-status{font-size:11px; color:var(--muted); margin-top:8px;}
.import-status.err{color:var(--bad);}

.review-table{width:100%; border-collapse:collapse; font-size:11.5px; margin-top:14px;}
.review-table th{text-align:left; font-size:10px; color:var(--muted); text-transform:uppercase; padding:5px 6px; border-bottom:1px solid var(--border);}
.review-table td{padding:4px 6px; border-bottom:1px solid var(--border); vertical-align:middle;}
.review-table input[type=text], .review-table input[type=number], .review-table select{width:100%; border:1px solid var(--border); border-radius:4px; padding:3px 5px; font-family:inherit; font-size:11.5px;}
.review-table input[type=checkbox]{width:14px; height:14px; accent-color:var(--good);}
.review-actions{display:flex; justify-content:space-between; align-items:center; margin-top:10px;}
</style>
</head>
<body>

<div class="tabbar">
  <button class="tabbtn active" data-tab="analise">Dashboard</button>
  <button class="tabbtn" data-tab="painel">Painel · Setembro</button>
  <button class="tabbtn" data-tab="importar">Importar</button>
  <button class="tabbtn" data-tab="basedados">Base de Dados</button>
</div>

<!-- ======================= TAB 1 ======================= -->
<div class="tabpage" id="tab-painel">

  <div class="month-bar">
    <button id="month-prev">‹</button>
    <select id="month-select"></select>
    <button id="month-next">›</button>
    <button id="month-add">+ novo mês</button>
    <button id="month-del" class="del-month">excluir mês</button>
  </div>

  <div class="title-row">
    <div class="gasto-box"><span class="label">Total de gastos:</span><input type="text" id="hdr-gastos" readonly></div>
    <h1 id="month-title">Setembro</h1>
    <div></div>
  </div>

  <div class="filter-bar">
    <span class="flabel">Filtros</span>
    <input type="text" id="filtro-texto" placeholder="buscar por nome...">
    <select id="filtro-categoria"><option value="">Todas categorias</option></select>
    <select id="filtro-tipo">
      <option value="">Todos os tipos</option>
      <option value="Débito">Débito</option>
      <option value="Crédito">Crédito</option>
    </select>
    <button class="clear-filters" id="filtro-limpar">limpar</button>
  </div>
  <div class="filter-note" id="filtro-nota" style="display:none;"></div>

  <div class="grid4">

    <div class="col">
      <div class="banner blue"><span>Total fixos</span><span id="b-fixos"></span></div>
      <div class="card">
        <div class="head">Fixos</div>
        <table>
          <thead><tr><th>Nome</th><th>Pago</th><th>Tipo</th><th>Categoria</th><th class="num">Valor</th><th></th></tr></thead>
          <tbody id="fixos-body"></tbody>
        </table>
        <button class="add-btn" data-add="fixos">+ adicionar conta fixa</button>
      </div>

      <div class="banner pink"><span>Total cartão de crédito</span><span id="b-cartao"></span></div>
      <div class="card">
        <div class="head">Cartão de crédito</div>
        <table>
          <thead><tr><th>Nome</th><th>Parc.</th><th>Tipo</th><th>Categoria</th><th class="num">Valor</th><th></th></tr></thead>
          <tbody id="cartao-body"></tbody>
        </table>
        <button class="add-btn" data-add="cartao">+ adicionar compra</button>
      </div>
    </div>

    <div class="col">
      <div class="card">
        <div class="head green">Categoria</div>
        <table>
          <thead><tr><th>Categoria</th><th class="num">Valor</th></tr></thead>
          <tbody id="cat-body"></tbody>
        </table>
        <div class="total-line"><span>total</span><span id="cat-total"></span></div>
      </div>

      <div class="card">
        <div class="head" style="background:#FBE2E5;color:#A62236;">Saídas (por forma de pagamento)</div>
        <table><tbody id="saidas-body"></tbody></table>
      </div>
    </div>

    <div class="col">
      <div class="banner yellow"><span>Total de gastos do mês</span><span id="b-gastos"></span></div>
      <div class="card">
        <div class="head pink">Gastos do mês</div>
        <table>
