<script>
const fmt = n => (isNaN(n)?0:n).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});
const num = v => { const n = parseFloat(v); return isNaN(n) ? 0 : n; };
const STORAGE_KEY = 'contabilidade_pessoal_v4';

const defaultPalette = ['#C0273D','#B05FCB','#3E9B5C','#7A4FC4','#4FAE72','#E08A2E','#2E7D46','#C9BB8E','#3B82B0','#B0473B','#5C8CBF','#9C6ADE'];
function colorForCategory(cat){
  const cats = state.budgets.map(b=>b.categoria);
  let idx = cats.indexOf(cat);
  if(idx<0) idx = cat.length;
  return defaultPalette[idx % defaultPalette.length];
}

function defaultMonthData(){
