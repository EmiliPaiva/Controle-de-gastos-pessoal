function categoryTotals(){
  const map = {};
  const c = cm();
  [...c.fixos, ...c.gastos, ...c.cartao].forEach(r=>{
    const cat=(r.categoria||'').trim(); if(!cat) return;
    map[cat]=(map[cat]||0)+num(r.valor);
  });
  return map;
}

function renderCategoriaCard(catMap){
  const entries = Object.entries(catMap).sort((a,b)=>b[1]-a[1]);
  document.getElementById('cat-body').innerHTML = entries.map(([c,v])=>{
    const hex = colorForCategory(c);
    return `<tr><td><span style="display:inline-block;width:8px;height:8px;border-radius:2px;background:${hex};margin-right:6px;"></span>${c}</td><td class="num">${fmt(v)}</td></tr>`;
  }).join('');
  const total = entries.reduce((s,[,v])=>s+v,0);
  document.getElementById('cat-total').textContent = fmt(total);

  let acc=0;
  const stops = entries.map(([c,v])=>{
    const start=acc/(total||1)*360; acc+=v; const end=acc/(total||1)*360;
    return `${colorForCategory(c)} ${start}deg ${end}deg`;
  }).join(', ');
  document.getElementById('pie').style.background = entries.length ? `conic-gradient(${stops})` : '#EEE';
  document.getElementById('legend').innerHTML = entries.map(([c,v])=>{
    const pct = total>0 ? (v/total*100).toFixed(1) : '0.0';
    return `<div class="item"><span class="dot" style="background:${colorForCategory(c)}"></span>${c}<span class="pct">${pct}%</span></div>`;
  }).join('');
}

function renderSaidas(totFixos, totGastos, totCartao){
  const soma = {Débito:0, Crédito:0};
  const c = cm();
  [...c.fixos, ...c.gastos, ...c.cartao].forEach(r=>{
    if(r.tipo==='Débito' || r.tipo==='Crédito') soma[r.tipo]+=num(r.valor);
  });
  const total = soma.Débito+soma.Crédito;
  document.getElementById('saidas-body').innerHTML = `
    <tr><td style="padding:5px 8px">Débito</td><td class="num" style="padding:5px 8px">${fmt(soma.Débito)}</td></tr>
    <tr><td style="padding:5px 8px">Crédito</td><td class="num" style="padding:5px 8px">${fmt(soma.Crédito)}</td></tr>
    <tr><td style="padding:5px 8px;font-weight:700;border-top:1px solid var(--border)">Total</td><td class="num" style="padding:5px 8px;font-weight:700;border-top:1px solid var(--border)">${fmt(total)}</td></tr>`;
  return soma;
}

function renderAnalise(catMap, saidas, totFixos, totGastos, totCartao, totEntradas){
  const totalGastosGeral = totFixos+totGastos+totCartao;
  const saldo = totEntradas - totalGastosGeral;

  // Gasto total do mês
  document.getElementById('k-gasto-total').textContent = fmt(totalGastosGeral);
  document.getElementById('k-gasto-total').style.color = 'var(--bad)';
  const gtSub = document.getElementById('k-gasto-total-sub');
  const pctGasto = totEntradas > 0 ? (totalGastosGeral/totEntradas*100) : 0;
  gtSub.textContent = pctGasto.toFixed(0)+'% da renda';
  gtSub.className = 'sub ' + (pctGasto>=100?'bad':pctGasto>=80?'warn':'good');

  // Saldo disponível
  document.getElementById('k-saldo-disp').textContent = fmt(saldo);
  document.getElementById('k-saldo-disp').style.color = saldo>=0 ? 'var(--good)' : 'var(--bad)';
  const sdSub = document.getElementById('k-saldo-disp-sub');
  if(saldo<0){ sdSub.textContent='renda excedida'; sdSub.className='sub bad'; }
  else if(saldo<totEntradas*0.1){ sdSub.textContent='margem muito apertada'; sdSub.className='sub warn'; }
  else{ sdSub.textContent='restante da remuneração'; sdSub.className='sub good'; }

  const comprometimento = totEntradas>0 ? (totalGastosGeral/totEntradas*100) : 0;
  document.getElementById('k-comprometimento').textContent = comprometimento.toFixed(0)+'%';
  const compSub = document.getElementById('k-comprometimento-sub');
  if(comprometimento>=100){compSub.textContent='renda comprometida — saldo negativo'; compSub.className='sub bad';}
  else if(comprometimento>=80){compSub.textContent='margem apertada'; compSub.className='sub warn';}
  else{compSub.textContent='dentro do previsto'; compSub.className='sub good';}

  let nAlertas=0;
  let reducList=[];
  state.budgets.forEach(b=>{
    const g = catMap[b.categoria]||0;
    if(g>b.absurdo || g>b.cuidado) nAlertas++;
    if(g>b.bom){ reducList.push({categoria:b.categoria, gasto:g, bom:b.bom, cuidado:b.cuidado, absurdo:b.absurdo, idx:((g-b.bom)/(b.bom||1))*100}); }
  });
  reducList.sort((a,b)=>b.idx-a.idx);
  document.getElementById('k-alertas').textContent = nAlertas;

  const indiceGeral = reducList.length ? (reducList.reduce((s,r)=>s+r.idx,0)/reducList.length) : 0;
  document.getElementById('k-indice').textContent = indiceGeral.toFixed(0)+'%';
  const idxSub = document.getElementById('k-indice-sub');
  if(indiceGeral===0){idxSub.textContent='nenhuma categoria acima do ideal'; idxSub.className='sub good';}
  else if(indiceGeral<40){idxSub.textContent='corte leve recomendado'; idxSub.className='sub warn';}
  else{idxSub.textContent='corte significativo recomendado'; idxSub.className='sub bad';}

  const totalPag = saidas.Débito+saidas.Crédito;
  const pctCredito = totalPag>0 ? (saidas.Crédito/totalPag*100) : 0;
  document.getElementById('k-credito').textContent = pctCredito.toFixed(0)+'%';
  const credSub = document.getElementById('k-credito-sub');
  credSub.textContent = pctCredito>=60 ? 'concentração alta no crédito' : 'uso equilibrado';
  credSub.className = 'sub ' + (pctCredito>=60?'warn':'good');

  const trackCats = state.budgets.map(b=>({...b, gasto:catMap[b.categoria]||0})).sort((a,b)=>b.gasto-a.gasto);
  document.getElementById('track-body').innerHTML = trackCats.map(t=>{
    const pct = Math.min(100,(t.gasto/(t.absurdo||1))*100);
    let cls='good'; if(t.gasto>t.absurdo) cls='bad'; else if(t.gasto>t.bom) cls='warn';
    return `<div class="bar-row">
      <div class="cat"><span class="sw" style="background:${colorForCategory(t.categoria)}"></span>${t.categoria}</div>
      <div class="bar-track2"><div class="bar-fill2" style="width:${pct}%;background:${cls==='good'?'var(--good)':cls==='warn'?'var(--warn)':'var(--bad)'}"></div></div>
      <div class="val">${fmt(t.gasto)}</div>
      <div class="pct">de ${fmt(t.absurdo)}</div>
    </div>`;
  }).join('') || `<p style="color:var(--muted)">adicione categorias no Controle de Gastos para acompanhar aqui.</p>`;

  const totSplit = saidas.Débito+saidas.Crédito || 1;
  document.getElementById('split-bar').innerHTML = `
    <span style="width:${saidas.Débito/totSplit*100}%; background:#6E3FC2"></span>
    <span style="width:${saidas.Crédito/totSplit*100}%; background:#8E5FDE"></span>`;
  document.getElementById('split-legend').innerHTML = `
    <span>● Débito ${fmt(saidas.Débito)} (${(saidas.Débito/totSplit*100).toFixed(0)}%)</span>
    <span>● Crédito ${fmt(saidas.Crédito)} (${(saidas.Crédito/totSplit*100).toFixed(0)}%)</span>`;

  const reducBody = document.getElementById('reduc-body');
  if(reducList.length===0){
    reducBody.innerHTML = `<div class="alert good"><span class="icon">✓</span><div class="body"><b>Nenhuma redução necessária</b><span>todas as categorias estão dentro da faixa "Bom".</span></div></div>`;
  }else{
    reducBody.innerHTML = reducList.map(r=>{
      const capped = Math.min(100, r.idx);
      let cls='warn'; if(r.gasto>r.absurdo) cls='bad'; else if(r.idx<20) cls='good';
      return `<div class="reduc-row">
        <div style="font-weight:700">${r.categoria}</div>
        <div class="reduc-track"><div class="reduc-fill" style="width:${capped}%"></div></div>
        <div class="reduc-idx ${cls}">${r.idx.toFixed(0)}%</div>
      </div>`;
    }).join('');
  }

  let alerts=[];
  state.budgets.forEach(b=>{
    const g = catMap[b.categoria]||0;
    if(g>b.absurdo) alerts.push({cls:'bad', icon:'⚠', title:`${b.categoria} passou do limite "Absurdo!"`, desc:`gasto de ${fmt(g)}, ${fmt(g-b.absurdo)} acima do teto de ${fmt(b.absurdo)}.`});
    else if(g>b.cuidado) alerts.push({cls:'warn', icon:'!', title:`${b.categoria} entrou na faixa "Cuidado"`, desc:`gasto de ${fmt(g)}, entre ${fmt(b.cuidado)} e ${fmt(b.absurdo)}.`});
  });
  if(saldo<0) alerts.unshift({cls:'bad', icon:'⚠', title:'Saldo do mês ficou negativo', desc:`gastos superaram as entradas em ${fmt(Math.abs(saldo))}.`});
  if(pctCredito>=60) alerts.push({cls:'warn', icon:'!', title:'Concentração alta de gastos no crédito', desc:`${pctCredito.toFixed(0)}% do total pago foi no crédito.`});
  if(alerts.length===0) alerts.push({cls:'good', icon:'✓', title:'Nenhum alerta neste mês', desc:'gastos dentro do planejado em todas as categorias.'});
  document.getElementById('alerts-body').innerHTML = alerts.map(a=>`
    <div class="alert ${a.cls}"><span class="icon">${a.icon}</span><div class="body"><b>${a.title}</b><span>${a.desc}</span></div></div>`).join('');

  // Pie chart
  const catEntries = Object.entries(catMap).sort((a,b)=>b[1]-a[1]);
  const totalCat = catEntries.reduce((s,[,v])=>s+v,0)||1;
  let pieAcc=0;
  const pieStops = catEntries.map(([c,v])=>{
    const start=pieAcc/totalCat*360; pieAcc+=v; const end=pieAcc/totalCat*360;
    return `${colorForCategory(c)} ${start}deg ${end}deg`;
  }).join(', ');
  document.getElementById('dash-pie').style.background = catEntries.length ? `conic-gradient(${pieStops})` : '#EEF0F3';
  document.getElementById('dash-legend').innerHTML = catEntries.map(([c,v])=>{
    const pct = (v/totalCat*100).toFixed(1);
    return `<div style="display:flex;align-items:center;gap:8px;font-size:11.5px;padding:3px 0;border-bottom:1px solid var(--border);">
      <span style="width:10px;height:10px;border-radius:2px;background:${colorForCategory(c)};flex-shrink:0;"></span>
      <span style="flex:1;font-weight:600;">${c}</span>
      <span style="color:var(--muted);font-size:10px;min-width:34px;text-align:right;">${pct}%</span>
      <span style="font-weight:700;min-width:68px;text-align:right;">${fmt(v)}</span>
    </div>`;
  }).join('') || '<span style="color:var(--muted);font-size:11px;">sem lançamentos ainda</span>';
}

