function tipoSelect(val, arr, i){
  const opts=['Débito','Crédito'];
  return `<select class="tipo-${val}" data-arr="${arr}" data-i="${i}" data-f="tipo">` +
    opts.map(o=>`<option value="${o}" ${o===val?'selected':''}>${o}</option>`).join('') + `</select>`;
}
function catInput(val, arr, i){
  const hex = colorForCategory(val);
  return `<input type="text" class="cat-input" style="background:${hex}22;color:${hex}" value="${val||''}" data-arr="${arr}" data-i="${i}" data-f="categoria">`;
}

function renderFixos(){
  const data = cm().fixos;
  let shown = 0;
  document.getElementById('fixos-body').innerHTML = data.map((r,i)=>{
    if(!passaFiltro(r)) return '';
    shown++;
    return `
    <tr>
      <td><input type="text" value="${r.nome||''}" data-arr="fixos" data-i="${i}" data-f="nome"></td>
      <td style="text-align:center"><input type="checkbox" ${r.pago?'checked':''} data-arr="fixos" data-i="${i}" data-f="pago"></td>
      <td>${tipoSelect(r.tipo,'fixos',i)}</td>
      <td>${catInput(r.categoria,'fixos',i)}</td>
      <td class="num"><input type="number" step="0.01" value="${r.valor||0}" data-arr="fixos" data-i="${i}" data-f="valor"></td>
      <td><button class="del-btn" data-del="fixos" data-i="${i}">✕</button></td>
