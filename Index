    {categoria:'Variáveis', bom:30, cuidado:50, absurdo:80},
    {categoria:'Contas', bom:80, cuidado:100, absurdo:150},
  ],
  fornecedores: [],
};

function cm(){ return state.months[state.currentMonth]; }

let filtro = { texto:'', categoria:'', tipo:'' };
function passaFiltro(r){
  if(filtro.categoria && r.categoria !== filtro.categoria) return false;
  if(filtro.tipo && r.tipo !== filtro.tipo) return false;
  if(filtro.texto && !(r.nome||'').toLowerCase().includes(filtro.texto.toLowerCase())) return false;
  return true;
}
function temFiltroAtivo(){ return !!(filtro.texto || filtro.categoria || filtro.tipo); }

function loadState(){
  try{
    const s = localStorage.getItem(STORAGE_KEY);
    if(s){
      const parsed = JSON.parse(s);
      if(parsed && parsed.months && parsed.monthOrder && parsed.monthOrder.length){
        state = parsed;
        if(!state.fornecedores) state.fornecedores = [];
      }
    }
  }
  catch(e){ console.error('erro ao carregar dados salvos', e); }
}
function saveState(){
  try{ localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); }
  catch(e){ console.error('erro ao salvar', e); }
}

/* TABS */
document.querySelectorAll('.tabbtn').forEach(btn=>{
  btn.addEventListener('click', ()=>{
